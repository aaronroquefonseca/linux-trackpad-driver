pkgbase = linux-trackpad-driver
	pkgdesc = Userspace Rust driver for Apple Magic Trackpad 2 (USB/BT core-init)
	pkgver = 0.1.0
	pkgrel = 1
	url = https://github.com/aaronroquefonseca/linux-trackpad-driver
	install = ltd.install
	arch = x86_64
	arch = aarch64
	license = MIT
	license = Apache-2.0
	makedepends = cargo
	depends = systemd
	depends = gcc-libs
	depends = glibc
	optdepends = libinput: pointer/palm processing for passthrough events and hwdb quirks (see INSTALL.md "hwdb note")
	backup = etc/linux-trackpad-driver/config.toml
	source = linux-trackpad-driver-0.1.0.tar.gz::https://github.com/aaronroquefonseca/linux-trackpad-driver/releases/download/v0.1.0/linux-trackpad-driver-v0.1.0-x86_64-unknown-linux-gnu.tar.gz
	sha256sums = SKIP

pkgname = linux-trackpad-driver
