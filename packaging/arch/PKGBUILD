# Maintainer: Aaron Roque Fonseca <https://github.com/aaronroquefonseca>
# AUR STABLE package for linux-trackpad-driver.
#
# Split-repo model: stable releases live in the AUR repo
# `linux-trackpad-driver` (this file); nightly VCS snapshots live in the
# SEPARATE repo `linux-trackpad-driver-nightly` (see PKGBUILD-nightly).
# This file is committed for review only — nothing pushes it to the AUR
# until the owner arms .github/workflows/release-tag.yml (job `aur-stable`).
#
# Release procedure: the release workflow sets pkgver/pkgrel from the tag
# and fills the tarball checksum from the draft Release's SHA256SUMS.
# Manual equivalent:
#   updpkgsums  # after pointing source= at the new release tarball
pkgname=linux-trackpad-driver
pkgver=0.1.0
pkgrel=1
pkgdesc="Userspace Rust driver for Apple Magic Trackpad 2 (USB/BT core-init)"
arch=('x86_64' 'aarch64')
url="https://github.com/aaronroquefonseca/linux-trackpad-driver"
license=('MIT' 'Apache-2.0')
depends=('systemd' 'gcc-libs' 'glibc')
makedepends=('cargo')
optdepends=('libinput: pointer/palm processing for passthrough events and hwdb quirks (see INSTALL.md "hwdb note")')
backup=('etc/linux-trackpad-driver/config.toml')
source=("linux-trackpad-driver-${pkgver}.tar.gz::https://github.com/aaronroquefonseca/linux-trackpad-driver/releases/download/v${pkgver}/linux-trackpad-driver-v${pkgver}-x86_64-unknown-linux-gnu.tar.gz")
# Release tarballs are per-arch; aarch64 users build from the same source
# tarball via the VCS -nightly package until per-arch release assets exist.
sha256sums=('SKIP')
install=ltd.install

build() {
  cd "linux-trackpad-driver-v${pkgver}-x86_64-unknown-linux-gnu"
  # Release tarballs ship a prebuilt `ltd`; nothing to compile.
  test -x ltd
}

package() {
  cd "linux-trackpad-driver-v${pkgver}-x86_64-unknown-linux-gnu"

  # Binary.
  install -Dm755 "ltd" "${pkgdir}/usr/bin/ltd"

  # Default config (conffile; see backup=() above).
  install -Dm644 "config/default.toml" "${pkgdir}/etc/linux-trackpad-driver/config.toml"

  # udev rules (vendor dir; never /etc/udev/rules.d for packaged rules).
  install -Dm644 "udev/99-linux-trackpad-driver.rules" "${pkgdir}/usr/lib/udev/rules.d/99-linux-trackpad-driver.rules"

  # systemd units (vendor dir).
  install -Dm644 "systemd/linux-trackpad-driver.service" "${pkgdir}/usr/lib/systemd/system/linux-trackpad-driver.service"
  install -Dm644 "systemd/linux-trackpad-driver-reconnect@.service" "${pkgdir}/usr/lib/systemd/system/linux-trackpad-driver-reconnect@.service"
  install -Dm644 "systemd/linux-trackpad-driver-resume.service" "${pkgdir}/usr/lib/systemd/system/linux-trackpad-driver-resume.service"

  # Suspend/resume hook (executable).
  install -Dm755 "systemd/system-sleep/ltd-resume" "${pkgdir}/usr/lib/systemd/system-sleep/ltd-resume"
}
