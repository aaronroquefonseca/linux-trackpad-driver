# udev rules for linux-trackpad-driver (Apple Magic Trackpad 2).
#
# What: on `add` of a matching hidraw node, ask systemd to run a one-shot
# `reconnect` for that node. The init itself is defer-retry-verify (waits for
# the node + driver bind, backoff-retries reports, verifies polling), so it
# must NEVER run long inside udev RUN — udev would kill/s stall it. Hence
# TAG+=systemd + SYSTEMD_WANTS (see RESEARCH.md §6), never RUN+=ltd.
#
# Trap avoided (systemd#37063): virtual `input` event nodes
# (devices/virtual/input/...) have no parent with idVendor/idProduct, so
# `SUBSYSTEM=="input", ATTRS{idVendor}` never matches there. These rules only
# match SUBSYSTEM=="hidraw", where ATTRS{idVendor}/ATTRS{idProduct} resolve
# via the physical USB parent. No SUBSYSTEM=="input" matching lives here at
# all — if input-node matching is ever needed, match by
# `SUBSYSTEM=="input", ATTR{name}` instead.
#
# Combos: VID 05ac/004c × PID 0265 (Lightning) /0324 (USB-C). udev match
# values are ANDed and have no alternation, so one rule per combo.
# %k = kernel name (e.g. hidraw2) → template instance.

ACTION=="add", SUBSYSTEM=="hidraw", ATTRS{idVendor}=="05ac", ATTRS{idProduct}=="0265", TAG+="systemd", ENV{SYSTEMD_WANTS}+="linux-trackpad-driver-reconnect@%k.service"
ACTION=="add", SUBSYSTEM=="hidraw", ATTRS{idVendor}=="05ac", ATTRS{idProduct}=="0324", TAG+="systemd", ENV{SYSTEMD_WANTS}+="linux-trackpad-driver-reconnect@%k.service"
ACTION=="add", SUBSYSTEM=="hidraw", ATTRS{idVendor}=="004c", ATTRS{idProduct}=="0265", TAG+="systemd", ENV{SYSTEMD_WANTS}+="linux-trackpad-driver-reconnect@%k.service"
ACTION=="add", SUBSYSTEM=="hidraw", ATTRS{idVendor}=="004c", ATTRS{idProduct}=="0324", TAG+="systemd", ENV{SYSTEMD_WANTS}+="linux-trackpad-driver-reconnect@%k.service"
