#!/bin/sh
# ltd-resume — systemd system-sleep hook: re-enable multitouch after resume.
#
# Install as /usr/lib/systemd/system-sleep/ltd-resume (or
# /etc/systemd/system-sleep/ltd-resume for a local override), mode 0755.
# systemd runs executables in system-sleep/ as:
#   ltd-resume pre|post suspend|hibernate|hybrid-sleep|suspend-then-hibernate
#
# SYSTEM-SIDE ONLY: user.slice is frozen while sleep hooks run (see
# docs/RESEARCH.md §6 "Sleep hooks"), so this hook MUST NOT touch user
# sessions: no systemctl --user, no su/sudo -u, no machinectl shell, no
# session D-Bus, no notify-send. It only re-runs the system entry
# `ltd resume`, which re-verifies every trackpad node and re-sends the USB
# init sequence from multitouch enable on mismatch (report 0x02 21→8 byte
# dropout fix: motion lost until re-init, clicks survive).
#
# `pre` is intentionally a no-op: suspend needs no disengage.
#
# Activation contract (finding #14): plain `ltd resume` below is the
# AUTOMATIC background form — without a live main-service daemon it leaves
# the hardware alone and exits 0, so installed-but-stopped (socket absent)
# stays off across sleep. Explicit manual forcing while stopped is
# `ltd resume -f`.
set -eu

LTD_BIN="${LTD_BIN:-/usr/bin/ltd}"
# Sleep hooks inherit PID1's environment, not any unit's Environment=: a
# custom LTD_CONFIG set only on the main unit does not reach this hook.
# This default keeps the hook explicit and matching the units; without it
# `ltd resume` would still read the installed file via the shared fallback
# (not built-in defaults when the installed file exists). A missing file
# falls back to defaults (same as the units). To use a custom path, set the
# same LTD_CONFIG on every unit/hook that launches ltd; there is no
# automatic cross-process propagation.
LTD_CONFIG="${LTD_CONFIG:-/etc/linux-trackpad-driver/config.toml}"
export LTD_CONFIG

case "${1:-} ${2:-}" in
    "post suspend" | "post hibernate" | "post hybrid-sleep" | "post suspend-then-hibernate")
        if [ -x "$LTD_BIN" ]; then
            # Journal trace proving the hook ran (failures below are
            # swallowed to exit 0, so these lines are the evidence).
            echo "ltd-resume: post ${2:-unknown}: running $LTD_BIN resume (LTD_CONFIG=$LTD_CONFIG)" >&2
            # Best-effort: a driver hiccup must never perturb the sleep
            # cycle, so a failure is reported (journal, with rc + exact
            # recovery command) and swallowed.
            if "$LTD_BIN" resume; then
                echo "ltd-resume: post ${2:-unknown}: resume pass done" >&2
            else
                rc=$?
                echo "ltd-resume: post ${2:-unknown}: ltd resume failed (rc=$rc); retry with: sudo systemctl start linux-trackpad-driver-resume.service (or: sudo ltd resume -f); see journal" >&2
            fi
        else
            echo "ltd-resume: $LTD_BIN missing or not executable; nothing re-inited" >&2
        fi
        ;;
esac

exit 0
