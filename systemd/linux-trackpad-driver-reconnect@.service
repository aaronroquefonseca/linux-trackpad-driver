# One-shot re-init for a hotplugged hidraw node, triggered by udev via
# SYSTEMD_WANTS (see ../udev/99-linux-trackpad-driver.rules). Instance is the
# kernel name, e.g. `systemctl start
# linux-trackpad-driver-reconnect@hidraw2.service` runs
# `ltd reconnect /dev/hidraw2`.
#
# Activation contract (finding #14): this unit is the AUTOMATIC background
# form (no -f). Without a live main-service daemon it is an inactive no-op:
# hardware left alone, exit 0. Installed-but-stopped (socket absent) is
# therefore off (`disable` alone does not stop a running service), even
# though udev still queues this unit on hotplug. Explicit manual forcing
# while the daemon is stopped is `ltd reconnect /dev/HIDRAW -f` (or -d to
# disengage) run directly — never via this template.
#
# Why a unit and not RUN+=: reconnect waits for the node + driver bind and
# retries reports with backoff — seconds of work that must never block udev.
[Unit]
Description=Linux Trackpad Driver — reconnect %I
After=systemd-udevd.service

[Service]
Type=oneshot
# System config for hotplug reconnects (udev passes no -c): explicit -c on
# the command line still wins. A missing file falls back to defaults so
# hotplug keeps working with no system config installed.
Environment=LTD_CONFIG=/etc/linux-trackpad-driver/config.toml
ExecStart=/usr/bin/ltd reconnect /dev/%I
Nice=10
