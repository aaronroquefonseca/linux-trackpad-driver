# One-shot re-init for a hotplugged hidraw node, triggered by udev via
# SYSTEMD_WANTS (see ../udev/99-linux-trackpad-driver.rules). Instance is the
# kernel name, e.g. `systemctl start
# linux-trackpad-driver-reconnect@hidraw2.service` runs
# `ltd reconnect /dev/hidraw2`.
#
# Why a unit and not RUN+=: reconnect waits for the node + driver bind and
# retries reports with backoff — seconds of work that must never block udev.
[Unit]
Description=Linux Trackpad Driver — reconnect %I
After=systemd-udevd.service

[Service]
Type=oneshot
# System config for hotplug reconnects (udev passes no -c): explicit -c on
# the command line still wins. A missing file falls back to defaults so
# hotplug keeps working with no system config installed.
Environment=LTD_CONFIG=/etc/linux-trackpad-driver/config.toml
ExecStart=/usr/bin/ltd reconnect /dev/%I
Nice=10

# Finding #19 containment, one-shot subset. Same filesystem + privilege
# restrictions as the main unit. Narrower socket families: one-shots only
# connect to the daemon's AF_UNIX socket (lock.rs daemon_socket_present);
# they never open the AF_NETLINK hotplug monitor, so AF_UNIX alone suffices.
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
# ProtectClock deferred (see main unit + SECURITY.md): pre-v252 RTC-only
# device allowlist denies hidraw/evdev/uinput.
ProtectHostname=yes
ProtectKernelLogs=yes
NoNewPrivileges=yes
RestrictSUIDSGID=yes
RestrictRealtime=yes
LockPersonality=yes
RestrictNamespaces=yes
RestrictAddressFamilies=AF_UNIX
# Deliberately OMITTED (see main unit + SECURITY.md): User=, device rules,
# CapabilityBoundingSet, SystemCallFilter, ProtectProc, PrivateUsers.
# Deferred for compat: ProtectClock (pre-v252 RTC allowlist denies devices).
