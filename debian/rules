#!/usr/bin/make -f
# debhelper sequencer. Units are installed but never auto-enabled or
# auto-started (see README.Debian): --no-enable --no-start keeps install
# consent with the admin.

%:
	dh $@

override_dh_auto_build:
	cargo build --release --locked

override_dh_auto_test:
	cargo test --locked --release

override_dh_auto_install:
	dh_auto_install
	install -Dm644 config/default.toml debian/linux-trackpad-driver/etc/linux-trackpad-driver/config.toml

override_dh_installsystemd:
	dh_installsystemd --no-enable --no-start
